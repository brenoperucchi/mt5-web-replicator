# Copy to .env and fill in. .env is gitignored and loaded by the dotenv gem.

# --- Database / Rails ---
DATABASE_PASSWORD=            # PostgreSQL password (falls back to credentials[:secret_database])
SECRET_KEY_BASE=              # Required in production (falls back to Rails credentials); `bin/rails secret`
RAILS_MASTER_KEY=             # Decrypts config/credentials if you use them
RAILS_MAX_THREADS=5           # Puma threads and DB pool size
RAILS_MIN_THREADS=5
WEB_CONCURRENCY=2             # Puma workers
PORT=3000
# RAILS_SERVE_STATIC_FILES=true   # Serve /public from Rails in production
# RAILS_LOG_TO_STDOUT=true        # Log to stdout in production

# --- Redis / Sidekiq / Action Cable ---
REDIS_URL=redis://localhost:6379/1

# --- Payments (Stripe is the default provider) ---
STRIPE_SECRET_KEY=            # sk_live_... / sk_test_...; used when the Payment row has no api_token
STRIPE_WEBHOOK_SECRET=        # whsec_...; used when the Payment row has no webhook_token
PAYMENT_CURRENCY=usd          # ISO currency for checkout sessions (default: usd; the production deploy uses brl)

# --- reCAPTCHA (sign-up / contact forms) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Future: Telegram (optional, experimental, disabled by default) ---
# Nothing here is required to boot or run the app. Set ENABLE_TELEGRAM=1 to
# turn the feature on; the TELEGRAM_API_* values are only read by
# db/seeds.rb for the initial store, TELEGRAM_BOT_TOKEN by the bot helpers.
# ENABLE_TELEGRAM=0
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_API_NUMBER=

# --- Seeds (development) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
# First store created by db:seed.
SEED_STORE_NAME=
SEED_STORE_URL=

# --- Maintenance rake tasks (lib/tasks/maintenance.rake), optional ---
# CLEAN_OLD_ORPHANED=true
# CLEAN_OLDER_THAN_DAYS=30
# DAYS=30
# BACKTRACE=1                 # Show full backtraces (disables Rails backtrace silencers)

# --- Public hosts ---
# Host used to build payment webhook and checkout return URLs (no scheme).
APP_DOMAIN=
# Hostnames handed to the MetaTrader clients for API calls (production / local).
API_HOSTNAME=
API_HOSTNAME_LOCAL=
API_HOSTNAME_LOCAL_COPY=

# --- Outgoing mail (ContactMailer, production only) ---
MAIL_FROM=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
