# Secrets for Kamal, resolved on the machine that runs `kamal deploy`.
# Never put raw values here: read them from the environment or a password manager, e.g.
#   STRIPE_SECRET_KEY=$(op read op://mt5/stripe/secret_key)

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
# POSTGRES_PASSWORD is embedded in a URL: it must be URL-safe (no @ : / ? # %).
# Generate it with `openssl rand -hex 32`.
DATABASE_URL=postgres://signalforex:$POSTGRES_PASSWORD@mt5_web_replicator-db:5432/signalforex
STRIPE_SECRET_KEY=$STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK_SECRET
SMTP_ADDRESS=$SMTP_ADDRESS
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
TELEGRAM_API_ID=$TELEGRAM_API_ID
TELEGRAM_API_HASH=$TELEGRAM_API_HASH
SEED_ADMIN_EMAIL=$SEED_ADMIN_EMAIL
SEED_ADMIN_PASSWORD=$SEED_ADMIN_PASSWORD
